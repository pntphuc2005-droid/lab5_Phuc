        {
          "name": "6. POST User - Duplicate Email",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Tao truoc 1 user co email moi, roi POST lai dung email do",
                  "const email = 'dup_' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set('dupEmail', email);",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/users',",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Authorization': 'Bearer ' + pm.variables.get('token'),",
                  "    'Content-Type': 'application/json'",
                  "  },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ name: 'Dup Seed', gender: 'male', email: email, status: 'active' }) }",
                  "}, function (err, res) {",
                  "  if (!err && res.code === 201) { pm.collectionVariables.set('dupUserId', res.json().id); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Error is about email field', function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b[0].field).to.eql('email');",
                  "});",
                  "// Don dep user seed",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/users/' + pm.collectionVariables.get('dupUserId'),",
                  "  method: 'DELETE',",
                  "  header: { 'Authorization': 'Bearer ' + pm.variables.get('token') }",
                  "}, function () {});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dup Test\",\n  \"gender\": \"male\",\n  \"email\": \"{{dupEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        }
